{
  "runtime_roots": {
    "global": "~/.claude",
    "project": "$CLAUDE_PROJECT_DIR/.claude"
  },
  "skills": [
    { "name": "cortex-audit",       "profiles": ["core", "full"] },
    { "name": "cortex-clarify",     "profiles": ["core", "full"] },
    { "name": "cortex-investigate", "profiles": ["core", "full"] },
    { "name": "cortex-research",    "profiles": ["core", "full"] },
    { "name": "cortex-review",      "profiles": ["core", "full"] },
    { "name": "cortex-spec",        "profiles": ["core", "full"] },
    { "name": "cortex-status",      "profiles": ["core", "full"] },
    { "name": "cortex-bridge",      "profiles": ["core", "full"] },
    { "name": "cortex-close",       "profiles": ["core", "full"] },
    { "name": "cortex-experiment",  "profiles": ["core", "full"] },
    { "name": "cortex-fit",         "profiles": ["core", "full"] },
    { "name": "cortex-stash",       "profiles": ["core", "full"] },
    { "name": "cortex-drive",       "profiles": ["core", "full"] },
    { "name": "cortex-intent",      "profiles": ["core", "full"] },
    { "name": "cortex-ship",        "profiles": ["core", "full"] },
    { "name": "power-search",       "profiles": ["full"] },
    { "name": "google",             "profiles": ["full"] },
    { "name": "cli",                "profiles": ["full"] }
  ],
  "agents": [
    "cortex-critic.md",
    "cortex-eval-designer.md",
    "cortex-scribe.md",
    "cortex-specifier.md"
  ],
  "hooks": [
    {
      "file": "cortex-phase-guard.sh",
      "wiring": "global"
    },
    {
      "file": "cortex-postcompact.js",
      "wiring": "global"
    },
    {
      "file": "cortex-precompact.sh",
      "wiring": "global"
    },
    {
      "file": "cortex-session-end.sh",
      "wiring": "global"
    },
    {
      "file": "cortex-session-start.sh",
      "wiring": "global"
    },
    {
      "file": "cortex-sync.sh",
      "wiring": "manual"
    },
    {
      "file": "cortex-task-completed.sh",
      "wiring": "global"
    },
    {
      "file": "cortex-task-created.sh",
      "wiring": "global"
    },
    {
      "file": "cortex-teammate-idle.sh",
      "wiring": "global"
    },
    {
      "file": "cortex-validator-trigger.sh",
      "wiring": "global"
    },
    {
      "file": "cortex-write-guard.sh",
      "wiring": "manual"
    },
    {
      "file": "auto-doc-sync.sh",
      "wiring": "manual"
    },
    {
      "file": "token-ledger.js",
      "wiring": "global"
    },
    {
      "file": "cortex-context-capacity.sh",
      "wiring": "global"
    },
    {
      "file": "cortex-distribute.sh",
      "wiring": "manual"
    },
    {
      "file": "cortex-distribute.py",
      "wiring": "manual"
    },
    {
      "file": "nlm-refresh.py",
      "wiring": "manual"
    }
  ],
  "hook_events": [
    {
      "event": "SessionStart",
      "hook_file": "cortex-session-start.sh"
    },
    {
      "event": "PreCompact",
      "hook_file": "cortex-precompact.sh"
    },
    {
      "event": "PostCompact",
      "hook_file": "cortex-postcompact.js"
    },
    {
      "event": "Stop",
      "hook_file": "cortex-session-end.sh",
      "async": true
    },
    {
      "event": "PreToolUse",
      "hook_file": "cortex-phase-guard.sh",
      "matcher": "Write|Edit",
      "timeout": 10
    },
    {
      "event": "PostToolUse",
      "hook_file": "cortex-validator-trigger.sh",
      "matcher": "Write|Edit",
      "async": true
    },
    {
      "event": "TaskCreated",
      "hook_file": "cortex-task-created.sh",
      "timeout": 5
    },
    {
      "event": "TaskCompleted",
      "hook_file": "cortex-task-completed.sh",
      "timeout": 10
    },
    {
      "event": "TeammateIdle",
      "hook_file": "cortex-teammate-idle.sh",
      "timeout": 5
    },
    {
      "event": "PostToolUse",
      "hook_file": "token-ledger.js",
      "async": true
    },
    {
      "event": "PostToolUse",
      "hook_file": "cortex-context-capacity.sh",
      "timeout": 5
    }
  ]
}
